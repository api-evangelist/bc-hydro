        ]
      },
      "crewStatusDescription": {
        "type": "string",
        "examples": [
          "Crew assigned"
        ]
      },
      "crewStatusNote": {
        "type": "string"
      },
      "dateOff": {
        "type": "integer",
        "examples": [
          1785032760000
        ]
      },
      "dateOn": {
        "type": [
          "integer",
          "null"
        ],
        "examples": [
